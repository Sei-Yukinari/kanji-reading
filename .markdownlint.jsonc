{
  // 日本語ドキュメント向けの設定。テンプレートの表・長文に合わせて一部ルールを緩めています。
  "default": true,
  // 行長制限なし(日本語の長文・表・URLで誤検知しやすいため)
  "MD013": false,
  // 同名見出しの重複を許可(セクションごとに「概要」等を使うため)
  "MD024": { "siblings_only": true },
  // インラインHTMLを許可(Blume/MDXコンポーネント・コメントを使うため)
  "MD033": false,
  // 見出しレベルのスキップは禁止のまま
  "MD001": true,
  // 先頭h1はfrontmatterのtitleで代替するため不要
  "MD041": false,
  // 裸URLを許可
  "MD034": false
}
