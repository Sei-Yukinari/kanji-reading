{
  "theme": "base",
  "fontFamily": "\"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Yu Gothic\", Meiryo, system-ui, sans-serif",
  "themeVariables": {
    "fontSize": "15px",
    "primaryColor": "#e6f6f4",
    "primaryBorderColor": "#0d9488",
    "primaryTextColor": "#1d1d1f",
    "secondaryColor": "#f5f5f7",
    "secondaryBorderColor": "#7a7a7a",
    "tertiaryColor": "#fafafc",
    "tertiaryBorderColor": "#cccccc",
    "lineColor": "#333333",
    "textColor": "#1d1d1f",
    "clusterBkg": "#fafafc",
    "clusterBorder": "#cccccc",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#e6f6f4",
    "actorBorder": "#0d9488",
    "actorTextColor": "#1d1d1f",
    "signalColor": "#333333",
    "signalTextColor": "#1d1d1f",
    "noteBkgColor": "#fff8e1",
    "noteBorderColor": "#d4a017",
    "activationBkgColor": "#ccebe7",
    "activationBorderColor": "#0d9488",
    "sectionBkgColor": "#e6f6f4",
    "altSectionBkgColor": "#ffffff",
    "taskBkgColor": "#0d9488",
    "taskBorderColor": "#0f766e",
    "taskTextColor": "#ffffff",
    "taskTextLightColor": "#ffffff",
    "taskTextDarkColor": "#1d1d1f",
    "doneTaskBkgColor": "#cccccc",
    "critBkgColor": "#fde2e2",
    "critBorderColor": "#c0392b",
    "todayLineColor": "#c0392b",
    "pie1": "#0d9488", "pie2": "#5eead4", "pie3": "#99f6e4", "pie4": "#ccfbf1",
    "quadrant1Fill": "#e6f6f4", "quadrant2Fill": "#fafafc", "quadrant3Fill": "#f5f5f7", "quadrant4Fill": "#ffffff",
    "quadrantPointFill": "#0d9488", "quadrantPointTextFill": "#1d1d1f"
  },
  "flowchart": { "htmlLabels": true, "curve": "basis", "padding": 12, "nodeSpacing": 40, "rankSpacing": 50 },
  "sequence": { "mirrorActors": false, "messageMargin": 40, "actorMargin": 60, "boxMargin": 12, "wrap": true, "width": 180 },
  "er": { "fontSize": 14 },
  "gantt": { "fontSize": 14, "barHeight": 28, "barGap": 6, "leftPadding": 120 },
  "mindmap": { "padding": 12, "maxNodeWidth": 260 }
}
