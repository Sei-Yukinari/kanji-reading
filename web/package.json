{
  "name": "kanji-reading-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run data:build && next dev",
    "data:build": "tsx scripts/build-data.ts",
    "build": "npm run data:build && npm test && next build && tsx scripts/build-sw.ts",
    "start": "npx serve out -l 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "fake-indexeddb": "^6.2.5",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serwist": "^9.5.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "@serwist/build": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
